  "cards": [
    {
      "dot": "cyan",
      "title": "主链路与数据边界",
      "items": [
        "浏览器经 fnOS 统一网关鉴权，由 Unix Socket 进入控制面，不暴露多余端口",
        "Tier 1–4 实体仲裁合并，校验位验证的法定实体享有绝对优先权",
        "原文与可逆映射不离开 NAS，本地 Web Crypto AES-256-GCM 加密保险箱"
      ]
    },
    {
      "dot": "emerald",
      "title": "Zero ML 控制面",
      "items": [
        "Python 3.12 主进程不 import 任何深度学习框架",
        "HardwareProbe 通过 nvidia-smi 独立子进程探测 GPU",
        "RuntimeManager 用 uv 维护隔离 venv 并探针验证 CUDA"
      ]
    },
    {
      "dot": "amber",
      "title": "执行面与模型",
      "items": [
        "GLiNER / SiameseUIE / MemPrivacy 推理于独立 Worker 子进程（JSONL IPC）",
        "模型从 ModelScope 固定 revision 下载，或经共享目录 realpath 校验导入",
        "权重安装与运行时就绪状态解耦，可补装运行时复用权重"
      ]
    }
  ]
